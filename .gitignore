# ============================================================
# ML / Data Science
# ============================================================
# Raw datasets (large files - use DVC or storage separately)
ml/datasets/raw/*.csv
ml/datasets/raw/*.json
ml/datasets/raw/*.xlsx
ml/datasets/raw/*.parquet
ml/datasets/raw/*.zip
ml/datasets/raw/*.tar.gz

# Processed large datasets (keep sample, exclude large processed)
ml/datasets/processed/*.csv
ml/datasets/processed/*.parquet

# Trained model artifacts (large binaries)
ml/models/saved/*.pkl
ml/models/saved/*.joblib
ml/models/saved/*.json
ml/models/saved/*.ubj
ml/models/saved/*.bin

# MLflow / experiment tracking
mlruns/
mlartifacts/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Model caches
*.cache
huggingface/

